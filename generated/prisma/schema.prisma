generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SkipRuleType {
  TITLE
  COMPANY
  URL
}

enum JobStatus {
  PENDING
  APPROVED
  REJECTED
}

// ── Users ───────────────────────────────────────────────────────────────────

// Everyone who uses the app. Each user is one job search with their own
// location, profile, settings and results. ADMIN accounts sign in to the
// dashboard (and the extension) and manage every user; USER accounts only
// sign in to the Chrome extension.
model User {
  id             Int       @id @default(autoincrement())
  // The sign-in ID, stored lower-case.
  username       String    @unique @db.VarChar(40)
  name           String    @db.VarChar(80)
  // "scrypt$<salt>$<hash>". The first admin of an install upgraded from the
  // single-password version may still hold the old value (plain text, or empty
  // for the default "admin"); it is hashed on the first sign-in.
  passwordHash   String    @default("")
  role           String    @default("USER") @db.VarChar(10)
  active         Boolean   @default(true)
  // Raised to sign the user out everywhere.
  sessionVersion Int       @default(1)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  settings        UserConfig[]
  jobs            ScrapedJob[]
  resumes         Resume[]
  answers         SavedAnswer[]
  skipRules       SkipRule[]
  extensionTokens ExtensionToken[]
}

// A browser signed in to the Chrome extension. Only the browser has the token;
// the server keeps its SHA-256 hash. It stops working when the user's
// sessionVersion moves on (disabled, new password, signed out everywhere) and
// when it is signed out in the popup or on Admin → Extension.
model ExtensionToken {
  id             Int       @id @default(autoincrement())
  userId         Int
  tokenHash      String    @unique @db.VarChar(64)
  // e.g. "Chrome 155 on Windows", from the browser's User-Agent.
  label          String    @db.VarChar(120)
  // The user's sessionVersion when the token was issued.
  sessionVersion Int
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A user's own settings (search options, Google Sheet, profile …), one row per
// key. App-wide settings stay in AppConfig.
model UserConfig {
  userId    Int
  key       String   @db.VarChar(255)
  value     String
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
}

// ── Core ────────────────────────────────────────────────────────────────────

// A job as found for one user: the same posting found for two users is two
// rows, each with its own verdict, pipeline and notes.
model ScrapedJob {
  id             Int       @id @default(autoincrement())
  userId         Int
  platform       String    @db.VarChar(50)
  title          String
  company        String
  location       String?
  url            String    @db.VarChar(2048)
  manualApplyUrl String?   @db.VarChar(2048)
  // How the job is applied to: "EASY_APPLY" (LinkedIn's in-site form) or
  // "EXTERNAL" (company / ATS site). Null when unknown (most board jobs).
  applyMethod    String?   @db.VarChar(20)
  description    String?
  salary         String?
  techStack      String?
  status         JobStatus @default(PENDING)
  aiScore        Int?
  aiReason       String?
  sheetSynced    Boolean   @default(false)
  createdAt      DateTime  @default(now())

  // ── Pipeline (applications board) ──
  // null = not in the pipeline yet; SAVED, APPLIED, INTERVIEW, OFFER,
  // REJECTED (by the company) or ARCHIVED.
  stage           String?   @db.VarChar(20)
  stageUpdatedAt  DateTime?
  appliedAt       DateTime?
  followUpAt      DateTime?
  notes           String?
  // Which resume variant was sent, and the answers given (JSON).
  resumeId        Int?
  applicationData String?

  // ── Your feedback on the AI verdict: 1 = good match, -1 = bad match ──
  feedback   Int?
  feedbackAt DateTime?
  // When the job left the Review queue: approved, rejected or "keep the AI
  // verdict" there, or "Mark all reviewed". Jobs marked together share it, so
  // Undo can find them.
  reviewedAt DateTime?

  // ── Signals ──
  // Where the company can hire, as judged by the AI: worldwide, europe,
  // emea, americas, specific, unclear.
  eligibility String? @db.VarChar(30)
  // JSON: { postedText, reposted, applicants, … } captured by the extension.
  signals     String?

  analysisLogs AnalysisLog[]
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, url])
  @@unique([userId, platform, title, company])
  @@index([stage])
  @@index([status, createdAt])
  @@index([userId, status, createdAt])
  @@index([userId, stage])
}

// ── Admin configuration ─────────────────────────────────────────────────────

model AppConfig {
  key       String   @id @db.VarChar(255)
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

// A user's own rule, or a rule for everyone when userId is null.
model SkipRule {
  id        Int          @id @default(autoincrement())
  userId    Int?
  type      SkipRuleType
  pattern   String
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Logging ─────────────────────────────────────────────────────────────────

// Logs keep the user they were for (no foreign key: a deleted user's logs
// stay until they age out).
model ScanLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  board      String   @db.VarChar(50)
  jobsFound  Int      @default(0)
  jobsSaved  Int      @default(0)
  errors     String?
  durationMs Int?
  createdAt  DateTime @default(now())
}

model AnalysisLog {
  id           Int      @id @default(autoincrement())
  scrapedJobId Int
  model        String   @db.VarChar(100)
  approved     Boolean
  score        Int?
  reason       String?
  tokensUsed   Int?
  durationMs   Int?
  createdAt    DateTime @default(now())

  scrapedJob ScrapedJob @relation(fields: [scrapedJobId], references: [id], onDelete: Cascade)
}

// ── Profile & resumes ───────────────────────────────────────────────────────

// An uploaded resume variant (e.g. ".NET backend", "Full-stack JS"). The file
// itself is stored in Postgres; resumes are small and this keeps the app to a
// single database with no extra storage service.
model Resume {
  id          Int      @id @default(autoincrement())
  userId      Int
  name        String   @db.VarChar(120)
  fileName    String   @db.VarChar(255)
  mimeType    String   @db.VarChar(100)
  sizeBytes   Int
  data        Bytes
  // Plain text extracted by Claude (used for answers and matching).
  textContent String?
  // JSON profile Claude extracted from this file.
  parsed      String?
  // Comma-separated keywords used to auto-pick this variant for a job.
  tags        String?  @db.VarChar(500)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Answers to recurring application questions, reused by autofill.
model SavedAnswer {
  id        Int      @id @default(autoincrement())
  userId    Int
  question  String
  answer    String
  tags      String?  @db.VarChar(300)
  uses      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One row per AI call (every provider, success or failure). Drives the usage
// & cost page, the Claude monthly budget cap, and provider health stats.
model AiUsage {
  id               Int      @id @default(autoincrement())
  // Whose work the call was for; null for app-wide calls (model lists, tests).
  userId           Int?
  task             String   @db.VarChar(30)
  provider         String   @db.VarChar(30)
  model            String   @db.VarChar(120)
  ok               Boolean  @default(true)
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  costUsd          Float    @default(0)
  durationMs       Int?
  error            String?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([provider, createdAt])
  @@index([userId, createdAt])
}

model ExtensionLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  level     String   @default("info") @db.VarChar(20)
  message   String
  sessionId String?  @db.VarChar(100)
  createdAt DateTime @default(now())
}
