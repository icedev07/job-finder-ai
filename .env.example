# Required: Supabase session pooler connection string (port 5432)
# Get it from Supabase > Connect > Direct > Session pooler > URI
# On Vercel the app connects to the same address through Supabase's transaction
# pooler (port 6543, pgbouncer=true), which serverless functions need, and keeps
# each function instance to 2 connections unless the URL sets connection_limit.
# Set DATABASE_POOL_MODE=session to keep the session pooler.
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-[n]-[region].pooler.supabase.com:5432/postgres

# Required on Vercel for the daily scan: Vercel Cron sends
# "Authorization: Bearer <CRON_SECRET>" to /api/admin/scanners/run, and the
# route refuses the scheduled scan without it. Generate: openssl rand -hex 32
CRON_SECRET=

# Recommended: signs the admin session cookie. When empty, a key derived from
# DATABASE_URL is used. Changing it signs every session out.
SESSION_SECRET=

# Optional: the first admin's password (user ID "admin"); overrides the stored
# one, handy if you are locked out. While it is set, that password cannot be
# changed in the admin panel.
# ADMIN_PASSWORD=change-me

# Optional: send Claude calls through a proxy or gateway instead of
# https://api.anthropic.com. The Anthropic API key itself is set in the
# admin panel (AI > Providers & keys), not here.
# ANTHROPIC_BASE_URL=

# Everything else (AI provider keys, AI routes and budget, Google Sheets,
# users, target market, extension settings, profile, etc.) is configured in the
# admin panel at /admin. Next.js sets NODE_ENV itself (dev = development,
# build/start = production).
